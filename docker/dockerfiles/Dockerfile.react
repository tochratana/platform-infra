FROM node:20-alpine AS builder
WORKDIR /app

COPY . .
RUN rm -rf node_modules && corepack enable && \
    if [ -f yarn.lock ]; then if [ -f .yarnrc.yml ]; then yarn install --immutable; else yarn install --frozen-lockfile; fi; \
    elif [ -f pnpm-lock.yaml ]; then corepack prepare pnpm@latest --activate && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; \
    else npm install; fi

RUN corepack enable && \
    if [ -f yarn.lock ]; then yarn build; \
    elif [ -f pnpm-lock.yaml ]; then corepack prepare pnpm@latest --activate && pnpm run build; \
    else npm run build; fi
RUN if [ -d dist ]; then cp -R dist /tmp/webroot; \
    elif [ -d build ]; then cp -R build /tmp/webroot; \
    else echo "React build output directory not found (expected dist/ or build/)" && exit 1; fi

FROM nginx:1.27-alpine
RUN apk upgrade --no-cache
COPY --from=builder /tmp/webroot/ /usr/share/nginx/html/
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
