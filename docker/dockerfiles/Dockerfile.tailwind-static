FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./

COPY . .
RUN rm -rf node_modules && \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi
RUN if node -e "const pkg = require('./package.json'); process.exit(pkg.scripts && pkg.scripts.build ? 0 : 1)"; then \
      npm run build; \
    elif [ -f src/input.css ]; then \
      echo "No build script found; compiling Tailwind from src/input.css."; \
      npm exec -- tailwindcss -i ./src/input.css -o ./src/output.css --minify; \
    else \
      echo "No build script found; serving checked-in static files."; \
    fi
RUN set -eux; \
    mkdir -p /tmp/webroot; \
    if [ -f dist/index.html ]; then \
      cp -R dist/. /tmp/webroot/; \
    elif [ -f build/index.html ]; then \
      cp -R build/. /tmp/webroot/; \
    elif [ -f public/index.html ]; then \
      cp -R public/. /tmp/webroot/; \
    elif [ -f src/index.html ]; then \
      cp -R src/. /tmp/webroot/; \
    elif [ -f index.html ]; then \
      cp -R . /tmp/webroot/; \
      rm -rf /tmp/webroot/node_modules /tmp/webroot/.git /tmp/webroot/.scannerwork; \
      rm -f /tmp/webroot/package.json /tmp/webroot/package-lock.json /tmp/webroot/pnpm-lock.yaml /tmp/webroot/yarn.lock; \
      rm -f /tmp/webroot/tailwind.config.* /tmp/webroot/postcss.config.*; \
    else \
      echo "Static HTML entrypoint not found (expected dist/index.html, build/index.html, public/index.html, src/index.html, or index.html)." >&2; \
      exit 1; \
    fi

FROM nginx:1.27-alpine
RUN apk upgrade --no-cache && rm -rf /usr/share/nginx/html/*
COPY --from=builder /tmp/webroot/ /usr/share/nginx/html/
RUN test -f /usr/share/nginx/html/index.html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
